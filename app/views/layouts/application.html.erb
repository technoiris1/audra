<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Audra" %> | Audra</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Audra">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body data-audio-player>
    <div class="app-shell">
      <aside class="sidebar">
        <%= link_to tracks_path, class: "brand" do %>
          <span class="brand-mark">a</span>
          <span>audra</span>
        <% end %>
        <nav class="sidebar-nav" aria-label="Primary navigation">
          <%= link_to tracks_path, class: "nav-link #{'is-active' if controller_name == 'tracks' && action_name == 'index'}" do %>
            <span class="nav-icon">[ ]</span>
            <span>All tracks</span>
          <% end %>
          <%= link_to new_track_path, class: "nav-link #{'is-active' if controller_name == 'tracks' && %w[new create].include?(action_name)}" do %>
            <span class="nav-icon">+</span>
            <span>Add music</span>
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <p>Made with <3 | <a href="https://github.com/technoiris1/audra" class = "href" target="_blank" rel="noopener noreferrer">Github</a></p>
        </div>
      </aside>

      <main class="main-content">
        <% if notice.present? %>
          <div class="flash" role="status"><%= notice %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <section class="mini-player" aria-label="Audio player">
      <div class="mini-player-track">
        <div class="mini-player-art" aria-hidden="true">A</div>
        <div class="mini-player-copy">
          <strong data-player-title>--</strong>
          <span data-player-artist>--</span>
        </div>
      </div>
      <div class="mini-player-controls">
        <div class="player-transport" aria-label="Playback controls">
          <button type="button" class="player-skip" data-player-skip="-10" aria-label="Back 10 seconds">←</button>
          <button type="button" class="player-button" data-player-toggle aria-label="Play selected track" disabled>
            <span data-player-icon aria-hidden="true">▶</span>
          </button>
          <button type="button" class="player-skip" data-player-skip="10" aria-label="Forward 10 seconds">→</button>
        </div>
        <div class="player-timeline">
          <span class="player-time" data-player-current>0:00</span>
          <div class="player-progress" data-player-progress-bar role="slider" aria-label="Track progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
            <span class="player-progress-fill" data-player-progress></span>
            <span class="player-progress-thumb" data-player-progress-thumb></span>
          </div>
          <span class="player-time" data-player-duration>0:00</span>
        </div>
        <audio class="mini-player-audio" data-player-audio preload="metadata">
          Your browser does not support audio playback.
        </audio>
      </div>
      <div class="mini-player-volume">
        <button type="button" class="player-volume-toggle" data-player-volume-toggle aria-label="Mute" aria-pressed="false">
          <span data-player-volume-icon><i data-lucide="volume-2"></i></span>
        </button>
        <input type="range" class="player-volume" data-player-volume min="0" max="1" step="0.01" value="0.8" aria-label="Volume" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0.8">
      </div>
    </section>

    <script src="https://unpkg.com/lucide@0.468.0"></script>
    <%= javascript_include_tag "application.js", "data-turbo-track": "reload", defer: true %>
  </body>
</html>
