<div id="<%= dom_id track %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= track.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Artist:</strong>
    <%= track.artist %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Album:</strong>
    <%= track.album %>
  </div>
</div>
