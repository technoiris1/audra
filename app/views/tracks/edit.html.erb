<% content_for :title, "Editing track" %>

<div class="form-page">
  <div class="page-kicker">LIBRARY / EDIT TRACK</div>
  <h1>Refine the track</h1>
  <p class="muted form-intro">Keep the details tidy so your library stays easy to browse.</p>

  <%= render "form", track: @track %>

  <%= link_to "View track", @track, class: "button-secondary" %>
  <%= link_to "Cancel", tracks_path, class: "button-secondary" %>
</div>
