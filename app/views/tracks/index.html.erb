
<div class="page-heading">
  <div>
    <h1>Library</h1>
  </div>

  <%= link_to new_track_path, class: "button-primary" do %>
    <span class="button-icon">+</span>
    <span>Add music</span>
  <% end %>
</div>

<div class="library-toolbar">
  <span><%= @tracks.count %> <%= "track".pluralize(@tracks.count) %></span>
  <span class="toolbar-note">Recently added</span>
</div>

<% if @tracks.any? %>
  <div class="track-grid">
    <% @tracks.each do |track| %>
      <article class="track-card">
        <div class="track-art">
          <%= link_to track_path(track), class: "track-card-link" do %>
            <% if track.respond_to?(:cover) && track.cover.attached? %>
              <%= image_tag track.cover %>
            <% else %>
              <span class="track-art-note">A</span>
            <% end %>
          <% end %>
          <% if track.audio_file.attached? %>
            <button type="button"
                    class="track-play-button"
                    data-player-track
                    data-player-title="<%= track.title %>"
                    data-player-artist="<%= track.artist.presence || 'Unknown artist' %>"
                    data-player-url="<%= url_for(track.audio_file) %>"
                    aria-label="Play <%= track.title %>">
              <span aria-hidden="true">▶</span>
            </button>
          <% end %>
        </div>

        <%= link_to track_path(track), class: "track-card-link" do %>
          <h3 class="track-title">
            <%= track.title %>
          </h3>

          <p class="track-artist">
            <%= track.artist.presence || "Unknown artist" %>
          </p>

          <% if track.album.present? %>
            <p class="track-album"><%= track.album %></p>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-icon">A</div>
    <h2>Your library is waiting.</h2>
    <p class="muted">Add your first track to get started.</p>

    <%= link_to "Add your first track", new_track_path,
        class: "button-primary" %>
  </div>
<% end %>
