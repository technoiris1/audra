
<div class="library-header">
  <div>
    <p class="eyebrow">YOUR COLLECTION</p>
    <h1>Your library</h1>
    <p class="muted">Every track, all in one place.</p>
  </div>

  <%= link_to "+ Add music", new_track_path,
      class: "button-primary" %>
</div>

<div class="library-meta">
  <span><%= @tracks.count %> tracks</span>
</div>

<% if @tracks.any? %>
  <div class="track-grid">
    <% @tracks.each do |track| %>
      <article class="track-card">
        <%= link_to track_path(track), class: "track-card-link" do %>
          <div class="track-art">
            <% if track.respond_to?(:cover) && track.cover.attached? %>
              <%= image_tag track.cover %>
            <% else %>
              <span>♫</span>
            <% end %>
          </div>

          <h3 class="track-title">
            <%= track.title %>
          </h3>

          <p class="track-artist">
            <%= track.artist.presence || "Unknown artist" %>
          </p>

          <% if track.album.present? %>
            <p class="track-album"><%= track.album %></p>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-icon">♫</div>
    <h2>Your library is waiting.</h2>
    <p class="muted">Add your first track to get started.</p>

    <%= link_to "Add your first track", new_track_path,
        class: "button-primary" %>
  </div>
<% end %>
