<%= form_with(model: track, class: "track-form") do |form| %>
  <% if track.errors.any? %>
    <div id="error_explanation" class="form-errors">
      <h2><%= pluralize(track.errors.count, "error") %> prohibited this track from being saved:</h2>

      <ul class="list-disc ml-6">
        <% track.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Song title", class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :artist %>
    <%= form.text_field :artist, placeholder: "Who made it?", class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :album %>
    <%= form.text_field :album, placeholder: "Album name", class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :audio_file, "Audio file" %>
    <%= form.file_field :audio_file, accept: "audio/*", class: "form-file" %>
    <span class="field-hint">MP3, WAV, M4A, or another audio file.</span>
  </div>

  <div class="form-actions">
    <%= form.submit track.persisted? ? "Save changes" : "Add to library", class: "button-primary" %>
  </div>
<% end %>
