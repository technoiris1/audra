<% content_for :title, "Showing track" %>

<div class="detail-page">
  <div class="page-kicker">YOUR COLLECTION / TRACK</div>
  <h1><%= @track.title %></h1>

  <div class="detail-summary">
    <div class="detail-art">A</div>
    <div>
      <h2><%= @track.title %></h2>
      <p><span class="detail-label">Artist</span><%= @track.artist.presence || "Unknown artist" %></p>
      <p><span class="detail-label">Album</span><%= @track.album.presence || "Single" %></p>
    </div>
  </div>

  <% if @track.audio_file.attached? %>
    <audio controls preload="metadata" class="audio-player">
      <source src="<%= url_for(@track.audio_file) %>">
      Your browser does not support audio playback.
    </audio>
  <% end %>

  <div class="detail-actions">
    <%= link_to "Edit track", edit_track_path(@track), class: "button-primary" %>
    <%= link_to "Back to library", tracks_path, class: "button-secondary" %>
    <%= button_to "Delete", @track, method: :delete, class: "button-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
